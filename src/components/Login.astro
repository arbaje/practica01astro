---
---
<main>
	<section class="formulario">
		<img class="logo" src="/logo_marca.png">
		<h1>Welcome Back</h1>

		<input type="text" placeholder="User">
		<input type="password" placeholder="Password">

		<a class="login" href="/tienda">Log in</a>
		<a class="google" href="/tienda">
			<img class="icono" src="/logo_google.png">
			Login with Google
		</a>
	</section>

	<section class="foto">
		<img src="/img_login.png">
	</section>
</main>

<style>
	main {
		display: flex;
		height: 100vh;
		font-family: Arial, sans-serif;
	}
	.formulario {
		width: 40%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: 20px;
	}
	.logo {
		width: 130px;
	}
	h1 {
		font-size: 45px;
		font-weight: 500;
		margin: 45px 0 60px 0;
	}
	input {
		width: 230px;
		padding: 10px;
		margin-bottom: 12px;
		background-color: rgb(240, 240, 240);
		border: 1px solid gray;
		border-radius: 6px;
	}
	.login {
		width: 252px;
		padding: 12px 0;
		margin-top: 20px;
		text-align: center;
		background-color: rgb(47, 138, 18);
		color: white;
		text-decoration: none;
		border-radius: 6px;
	}
	.google {
		width: 230px;
		padding: 12px 0 12px 20px;
		margin-top: 12px;
		display: flex;
		align-items: center;
		background-color: rgb(240, 240, 240);
		color: gray;
		text-decoration: none;
		border: 1px solid gray;
		border-radius: 6px;
	}
	.icono {
		width: 20px;
		height: 20px;
		margin-right: 25px;
	}
	.foto {
		width: 60%;
		height: 100vh;
	}
	.foto img {
		width: 100%;
		height: 100%;
		object-fit: fill;
		display: block;
	}
</style>